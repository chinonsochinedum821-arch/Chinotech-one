let cart=[];
let selectedProduct=null;


const categories=[
...new Set(products.map(p=>p.category))
];


function money(number){

return Number(number).toLocaleString("en-NG");

}


function renderCategories(){

const categoryBox=
document.getElementById("categories");

const nav=
document.getElementById("nav");

const filter=
document.getElementById("categoryFilter");

const sell=
document.getElementById("sellCategory");

categories.forEach(category=>{

categoryBox.innerHTML+=`
<div
class="category"
onclick="chooseCategory('${category}')">

<div>🛍️</div>

<b>${category}</b>

</div>
`;

nav.innerHTML+=`
<button
onclick="chooseCategory('${category}')">

${category}

</button>
`;

filter.innerHTML+=`
<option value="${category}">
${category}
</option>
`;

sell.innerHTML+=`
<option>
${category}
</option>
`;

});

document.getElementById("categoryCount").textContent=
categories.length;

}


function chooseCategory(category){

document.getElementById("categoryFilter").value=
category;

renderProducts();

document.getElementById("products").scrollIntoView({
behavior:"smooth"
});

}


function renderProducts(){

let search=
(
document.getElementById("search").value+
" "+
document.getElementById("filterSearch").value
).toLowerCase();

let category=
document.getElementById("categoryFilter").value;

let sort=
document.getElementById("sort").value;


let list=products.filter(product=>{

let matchCategory=
category==="all" ||
product.category===category;

let matchSearch=
!search ||
product.name.toLowerCase().includes(search) ||
product.category.toLowerCase().includes(search);

return matchCategory && matchSearch;

});


if(sort==="low"){

list.sort((a,b)=>a.price-b.price);

}

if(sort==="high"){

list.sort((a,b)=>b.price-a.price);

}


document.getElementById("productGrid").innerHTML=
list.map(product=>`

<div class="card">

<img
class="productImage"
src="${product.image}"
alt="${product.name}"
loading="lazy"
onerror="this.src='https://placehold.co/900x600?text=${encodeURIComponent(product.name)}'"
>

<div class="cardBody">

<div class="categoryText">
${product.category}
</div>

<div class="productName">
${product.name}
</div>

<div class="stars">
★★★★★
</div>

<div class="price">
₦${money(product.price)}
</div>

<div class="cardButtons">

<button
class="add"
onclick="addToCart('${product.id}')">

🛒 ADD

</button>

<button
class="view"
onclick="viewProduct('${product.id}')">

VIEW

</button>

</div>

</div>

</div>

`).join("");


document.getElementById("productCount").textContent=
products.length;

}


function addToCart(id){

let product=
products.find(p=>p.id===id);

let existing=
cart.find(p=>p.id===id);

if(existing){

existing.quantity++;

}else{

cart.push({
...product,
quantity:1
});

}

updateCart();

}


function updateCart(){

let count=
cart.reduce(
(total,item)=>total+item.quantity,
0
);

document.getElementById("cartCount").textContent=
count;


document.getElementById("cartItems").innerHTML=

cart.length?

cart.map(item=>`

<div class="cartItem">

<img src="${item.image}">

<div class="cartInfo">

<b>${item.name}</b>

<br>

₦${money(item.price)}

<br>

<div class="qty">

<button onclick="changeQuantity('${item.id}',-1)">
−
</button>

${item.quantity}

<button onclick="changeQuantity('${item.id}',1)">
+
</button>

</div>

</div>

</div>

`).join("")

:

"<p>Your cart is empty.</p>";


let total=
cart.reduce(
(sum,item)=>
sum+(item.price*item.quantity),
0
);


document.getElementById("cartTotal").textContent=
money(total);

}


function changeQuantity(id,change){

let item=
cart.find(p=>p.id===id);

item.quantity+=change;

if(item.quantity<=0){

cart=
cart.filter(p=>p.id!==id);

}

updateCart();

}


function openCart(){

document
.getElementById("cartOverlay")
.classList.add("show");

}


function closeCart(){

document
.getElementById("cartOverlay")
.classList.remove("show");

}


function checkout(){

if(cart.length===0){

alert("Your cart is empty.");

return;

}


/*
Your exact Paystack Payment Page.
*/

window.location.href=
PAYSTACK_URL;

}


function viewProduct(id){

selectedProduct=
products.find(p=>p.id===id);

document.getElementById("modalName").textContent=
selectedProduct.name;

document.getElementById("modalImage").src=
selectedProduct.image;

document.getElementById("modalPrice").textContent=
money(selectedProduct.price);

document.getElementById("modalDescription").textContent=
"CHINOTECH ONE marketplace product. Confirm stock, condition and final price before purchasing.";

document
.getElementById("productModal")
.classList.add("show");

}


function closeProduct(){

document
.getElementById("productModal")
.classList.remove("show");

}


function buyNow(){

window.location.href=
PAYSTACK_URL;

}


function openSell(){

document
.getElementById("sellModal")
.classList.add("show");

}


function closeSell(){

document
.getElementById("sellModal")
.classList.remove("show");

}


function sellProduct(event){

event.preventDefault();


let newProduct={

id:
"seller-"+Date.now(),

name:
document.getElementById("sellName").value,

category:
document.getElementById("sellCategory").value,

price:
Number(
document.getElementById("sellPrice").value
),

image:
document.getElementById("sellImage").value

};


products.unshift(newProduct);

renderProducts();

closeSell();

alert("Product added successfully!");

}


renderCategories();

renderProducts();

updateCart();

</script>

</body>
</html>
