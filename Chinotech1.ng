<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CHINOTECH ONE MARKETPLACE</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f3f4f6;
  color:#111827;
}

header{
  background:#111827;
  color:white;
  position:sticky;
  top:0;
  z-index:100;
}

.top{
  max-width:1500px;
  margin:auto;
  padding:12px;
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}

.logo{
  font-size:20px;
  font-weight:bold;
  color:#facc15;
}

.search{
  flex:1;
  min-width:220px;
  display:flex;
}

.search input{
  flex:1;
  padding:12px;
  border:0;
  border-radius:7px 0 0 7px;
}

.search button{
  background:#facc15;
  border:0;
  padding:0 18px;
  border-radius:0 7px 7px 0;
}

.top button{
  padding:10px;
  border:0;
  border-radius:7px;
  font-weight:bold;
}

.sellBtn{
  background:#22c55e;
  color:white;
}

.cartBtn{
  background:#facc15;
}

nav{
  overflow:auto;
  white-space:nowrap;
  background:#1f2937;
  padding:5px;
}

nav button{
  background:transparent;
  color:white;
  border:0;
  padding:10px;
}

.hero{
  max-width:1500px;
  margin:20px auto;
  padding:15px;
}

.heroBox{
  padding:40px;
  min-height:280px;
  border-radius:18px;
  color:white;
  background:
    linear-gradient(90deg,#111827ee,#11182755),
    url("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1600&q=85")
    center/cover;
}

.hero h1{
  font-size:44px;
  margin:0 0 10px;
}

.hero button{
  background:#facc15;
  border:0;
  padding:13px 20px;
  border-radius:7px;
  font-weight:bold;
}

.section{
  max-width:1500px;
  margin:25px auto;
  padding:0 15px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
}

.stat{
  background:white;
  padding:18px;
  border-radius:10px;
  border:1px solid #ddd;
}

.stat strong{
  display:block;
  font-size:24px;
  margin-top:5px;
}

.categories{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(110px,1fr));
  gap:10px;
}

.category{
  background:white;
  border:1px solid #ddd;
  border-radius:10px;
  padding:14px;
  text-align:center;
  cursor:pointer;
}

.category div{
  font-size:28px;
}

.filters{
  background:white;
  padding:12px;
  border-radius:10px;
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.filters input,
.filters select{
  padding:10px;
  border:1px solid #ccc;
  border-radius:7px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:12px;
  margin-top:15px;
}

.card{
  background:white;
  border-radius:10px;
  overflow:hidden;
  border:1px solid #ddd;
}

.productImage{
  width:100%;
  height:180px;
  object-fit:cover;
  display:block;
  background:#eee;
}

.cardBody{
  padding:10px;
}

.categoryText{
  font-size:11px;
  color:#6b7280;
}

.productName{
  font-weight:bold;
  min-height:38px;
  margin-top:4px;
}

.stars{
  color:#f59e0b;
}

.price{
  font-size:18px;
  font-weight:bold;
  margin:6px 0;
}

.cardButtons{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:5px;
}

.cardButtons button{
  padding:9px;
  border:0;
  border-radius:6px;
  font-weight:bold;
}

.add{
  background:#facc15;
}

.view{
  background:#111827;
  color:white;
}

.chart{
  background:white;
  padding:20px;
  border-radius:10px;
}

.bars{
  height:220px;
  display:flex;
  align-items:flex-end;
  gap:10px;
}

.bar{
  flex:1;
  background:#facc15;
  border-radius:5px 5px 0 0;
  position:relative;
}

.bar span{
  position:absolute;
  bottom:-22px;
  left:50%;
  transform:translateX(-50%);
  font-size:10px;
}

.overlay{
  display:none;
  position:fixed;
  inset:0;
  background:#0009;
  z-index:200;
}

.overlay.show{
  display:block;
}

.drawer{
  width:min(440px,95%);
  height:100%;
  margin-left:auto;
  background:white;
  padding:18px;
  overflow:auto;
}

.head{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.close{
  background:#ef4444;
  color:white;
  border:0;
  padding:7px 11px;
  border-radius:6px;
}

.cartItem{
  display:flex;
  gap:10px;
  padding:12px 0;
  border-bottom:1px solid #ddd;
}

.cartItem img{
  width:70px;
  height:70px;
  object-fit:cover;
  border-radius:7px;
}

.cartInfo{
  flex:1;
}

.qty button{
  width:25px;
}

.pay{
  width:100%;
  background:#facc15;
  border:0;
  padding:13px;
  border-radius:7px;
  font-weight:bold;
}

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:#0009;
  z-index:300;
  align-items:center;
  justify-content:center;
  padding:15px;
}

.modal.show{
  display:flex;
}

.modalBox{
  width:min(600px,100%);
  background:white;
  border-radius:12px;
  padding:18px;
  max-height:90vh;
  overflow:auto;
}

.modalImage{
  width:100%;
  height:300px;
  object-fit:cover;
  border-radius:8px;
}

.field{
  margin:10px 0;
}

.field label{
  display:block;
  font-weight:bold;
  font-size:12px;
  margin-bottom:5px;
}

.field input,
.field select{
  width:100%;
  padding:11px;
  border:1px solid #ccc;
  border-radius:7px;
}

.publish{
  background:#22c55e;
  color:white;
  border:0;
  padding:12px;
  border-radius:7px;
  font-weight:bold;
}

footer{
  background:#111827;
  color:white;
  padding:35px 15px;
  margin-top:30px;
}

@media(max-width:1100px){
  .grid{
    grid-template-columns:repeat(4,1fr);
  }
}

@media(max-width:800px){
  .grid{
    grid-template-columns:repeat(3,1fr);
  }

  .stats{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:520px){
  .grid{
    grid-template-columns:repeat(2,1fr);
  }

  .hero h1{
    font-size:32px;
  }

  .productImage{
    height:145px;
  }
}
</style>
</head>

<body>

<header>

<div class="top">

<div class="logo">
CHINOTECH ONE<br>
MARKETPLACE
</div>

<div class="search">
<input
id="search"
placeholder="Search phones, cars, shoes..."
oninput="renderProducts()">

<button onclick="renderProducts()">🔍</button>
</div>

<button class="cartBtn" onclick="openCart()">
🛒 CART <span id="cartCount">0</span>
</button>

<button class="sellBtn" onclick="openSell()">
SELL
</button>

</div>

<nav id="nav"></nav>

</header>


<section class="hero">

<div class="heroBox">

<h1>CHINOTECH ONE MARKETPLACE</h1>

<p>
Phones, cars, televisions, fans, laptops,
fashion, beauty, jewelry, drones, watches,
electronics and much more.
</p>

<button onclick="document.getElementById('products').scrollIntoView()">
SHOP NOW
</button>

</div>

</section>


<section class="section">

<div class="stats">

<div class="stat">
PRODUCTS
<strong id="productCount">0</strong>
</div>

<div class="stat">
CATEGORIES
<strong id="categoryCount">0</strong>
</div>

<div class="stat">
SELL
<strong>OPEN</strong>
</div>

<div class="stat">
MARKET
<strong>24/7</strong>
</div>

</div>

</section>


<section class="section">

<h2>Categories</h2>

<div class="categories" id="categories"></div>

</section>


<section class="section">

<h2>Marketplace Chart</h2>

<div class="chart">

<div class="bars">

<div class="bar" style="height:80%">
<span>Phones</span>
</div>

<div class="bar" style="height:65%">
<span>Cars</span>
</div>

<div class="bar" style="height:90%">
<span>Fashion</span>
</div>

<div class="bar" style="height:75%">
<span>Electronics</span>
</div>

<div class="bar" style="height:55%">
<span>Beauty</span>
</div>

<div class="bar" style="height:70%">
<span>Gadgets</span>
</div>

</div>

</div>

</section>


<section class="section" id="products">

<h2>All Products</h2>

<div class="filters">

<input
id="filterSearch"
placeholder="Search..."
oninput="renderProducts()">

<select id="categoryFilter" onchange="renderProducts()">
<option value="all">All Categories</option>
</select>

<select id="sort" onchange="renderProducts()">
<option value="recommended">Recommended</option>
<option value="low">Price: Low → High</option>
<option value="high">Price: High → Low</option>
</select>

</div>

<div class="grid" id="productGrid"></div>

</section>


<!-- CART -->

<div class="overlay" id="cartOverlay">

<div class="drawer">

<div class="head">

<h2>🛒 My Cart</h2>

<button class="close" onclick="closeCart()">×</button>

</div>

<div id="cartItems"></div>

<h2>
Total: ₦<span id="cartTotal">0</span>
</h2>

<button class="pay" onclick="checkout()">
💳 PAY WITH PAYSTACK
</button>

</div>

</div>


<!-- PRODUCT MODAL -->

<div class="modal" id="productModal">

<div class="modalBox">

<div class="head">

<h2 id="modalName"></h2>

<button class="close" onclick="closeProduct()">
×
</button>

</div>

<img id="modalImage" class="modalImage">

<p id="modalDescription"></p>

<h2>
₦<span id="modalPrice"></span>
</h2>

<button class="pay" onclick="buyNow()">
BUY NOW
</button>

</div>

</div>


<!-- SELL MODAL -->

<div class="modal" id="sellModal">

<div class="modalBox">

<div class="head">

<h2>Sell on CHINOTECH ONE</h2>

<button class="close" onclick="closeSell()">
×
</button>

</div>

<form onsubmit="sellProduct(event)">

<div class="field">

<label>Product name</label>

<input id="sellName" required>

</div>

<div class="field">

<label>Category</label>

<select id="sellCategory"></select>

</div>

<div class="field">

<label>Price ₦</label>

<input id="sellPrice" type="number" required>

</div>

<div class="field">

<label>Product image URL</label>

<input
id="sellImage"
type="url"
placeholder="https://example.com/photo.jpg"
required>

</div>

<button class="publish">
PUBLISH PRODUCT
</button>

</form>

</div>

</div>


<footer>

<h3>CHINOTECH ONE MARKETPLACE</h3>

<p>
Shop • Sell • Electronics • Cars • Fashion • Beauty • Jewelry • Gadgets
</p>

</footer>


<script>

/* YOUR EXACT PAYSTACK LINK */

const PAYSTACK_URL =
"https://paystack.shop/pay/-lx13gxkac";


